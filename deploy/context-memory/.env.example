# Context & Memory data layer — copy to .env and edit. Nothing secret ships in the repo.

# --- Postgres (context + memory + short-lived planes) ---
POSTGRES_DB=asterguard
POSTGRES_USER=asterguard
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Qdrant (semantic recall collections) ---
QDRANT_PORT=6333

# Embedding dimension — MUST match the model the AsterVault MCP server embeds with.
# 1536 = OpenAI text-embedding-3-small (default). 3072 = text-embedding-3-large. 384/768 = common local models.
ASTERGUARD_EMBED_DIM=1536

# --- What the MCP server reads (set these where the server runs, pointing at the stores above) ---
# ASTERVAULT_DATABASE_URL=postgresql://asterguard:change-me@localhost:5432/asterguard
# ASTERVAULT_PACKS_QDRANT_URL=http://localhost:6333
#
# Single-node, no Postgres? The server can use a durable SQLite file instead for memory:
# ASTERVAULT_MEMORY_DB=/var/astervault/knowledge.db
